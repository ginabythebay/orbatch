{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*basedpyright*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-bare-basedpyright.sh"
          }
        ]
      }
    ]
  }
}
